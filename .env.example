# ─────────────────────────────────────────────────────────────────────────────
# AutoReactionBot — Environment Variables
# Copy this file to .env and fill in your values.
# ─────────────────────────────────────────────────────────────────────────────

# [REQUIRED] Your bot token from @BotFather
BOT_TOKEN=1234567890:ABCDefGhIJKlmNoPQRsTUVwxYZ

# [REQUIRED] Your Telegram user ID (integer) — get it from @userinfobot
OWNER_ID=123456789

# [REQUIRED] Your public Telegram username shown in the /start screen
DEVELOPER_USERNAME=@yourusername

# ─── Optional Links ───────────────────────────────────────────────────────────

# Link shown on "More Bots" button
MORE_BOTS_LINK=https://t.me/yourbotschannel

# ─── Logging ──────────────────────────────────────────────────────────────────

# Log level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Optional: send error logs to a Telegram channel (0 = disabled)
LOG_CHANNEL_ID=0

# ─── Reaction Tuning ──────────────────────────────────────────────────────────

# Seconds to wait between each reaction send (float)
REACTION_DELAY=0.5

# Seconds before the same chat can trigger another reaction (float)
REACTION_COOLDOWN=2.0

# Maximum items to hold in the reaction queue before dropping
REACTION_QUEUE_MAX_SIZE=500

# How many times to retry a failed reaction before skipping
REACTION_RETRY_COUNT=3

# Seconds to wait between retries
REACTION_RETRY_DELAY=1.0

# Flood protection: max reactions per FLOOD_WINDOW seconds (global)
FLOOD_THRESHOLD=10
FLOOD_WINDOW=10.0

# Per-chat rate limit: max reactions per RATE_LIMIT_WINDOW seconds
RATE_LIMIT_PER_CHAT=5
RATE_LIMIT_WINDOW=10.0

# ─── Broadcast ────────────────────────────────────────────────────────────────

# How many messages to send per batch during broadcasts
BROADCAST_BATCH_SIZE=25

# Seconds between each broadcast send (to avoid Telegram flood limits)
BROADCAST_DELAY=0.05

# ─── Force Join ───────────────────────────────────────────────────────────────

# How often (seconds) to re-check force-join membership (for background jobs)
FORCE_JOIN_CHECK_INTERVAL=3600

# ─── Health Check ─────────────────────────────────────────────────────────────

# How often (seconds) to run internal health checks
HEALTH_CHECK_INTERVAL=300
